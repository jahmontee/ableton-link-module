@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix lv2: <http://lv2plug.in/ns/lv2core#> .
@prefix doap: <http://usefulinc.com/ns/doap#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix state: <http://lv2plug.in/ns/ext/state#> .
@prefix urid: <http://lv2plug.in/ns/ext/urid#> .
<urn:hector-community:link:sync> a lv2:Plugin ; lv2:binary <module.so> ; doap:name "Ableton Link" ; doap:license <https://www.gnu.org/licenses/old-licenses/gpl-2.0.html> ; lv2:optionalFeature urid:map ; lv2:extensionData state:interface ; lv2:minorVersion 4 ; lv2:microVersion 0 ;
 lv2:port
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 0 ; lv2:symbol "enabled" ; lv2:name "Link Enabled" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 1 ; lv2:symbol "start_stop_sync" ; lv2:name "Start Stop Sync" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 2 ; lv2:symbol "tempo_request" ; lv2:name "Set Tempo (0 = Follow)" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 999 ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 3 ; lv2:symbol "quantum" ; lv2:name "Launch Quantum (beats)" ; lv2:default 4 ; lv2:minimum 1 ; lv2:maximum 32 ; lv2:portProperty lv2:integer ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 4 ; lv2:symbol "ppq" ; lv2:name "Pulses per Quarter Note" ; lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 24 ; lv2:portProperty lv2:integer ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 5 ; lv2:symbol "transport" ; lv2:name "Transport (-1 = Hold)" ; lv2:default -1 ; lv2:minimum -1 ; lv2:maximum 1 ; lv2:portProperty lv2:integer ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 6 ; lv2:symbol "bpm" ; lv2:name "BPM" ; lv2:default 120 ; lv2:minimum 0 ; lv2:maximum 999 ],
 [ a lv2:OutputPort, lv2:CVPort ; lv2:index 7 ; lv2:symbol "clock" ; lv2:name "Clock Pulse" ],
 [ a lv2:OutputPort, lv2:CVPort ; lv2:index 8 ; lv2:symbol "running" ; lv2:name "Run Gate" ],
 [ a lv2:OutputPort, lv2:CVPort ; lv2:index 9 ; lv2:symbol "reset" ; lv2:name "Start Reset Trigger" ],
 [ a lv2:OutputPort, lv2:CVPort ; lv2:index 10 ; lv2:symbol "phase" ; lv2:name "Quantum Phase" ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 11 ; lv2:symbol "peers" ; lv2:name "Connected Peers" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 999 ],
 [ a lv2:OutputPort, lv2:ControlPort ; lv2:index 12 ; lv2:symbol "helper_online" ; lv2:name "Connection Ready" ; lv2:default 0 ; lv2:minimum 0 ; lv2:maximum 1 ; lv2:portProperty lv2:toggled ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 13 ; lv2:symbol "offset_ms" ; lv2:name "Link Offset (ms)" ; lv2:default 0 ; lv2:minimum -500 ; lv2:maximum 500 ; lv2:portProperty lv2:integer, lv2:connectionOptional ],
 [ a lv2:InputPort, lv2:ControlPort ; lv2:index 14 ; lv2:symbol "clock_width_ms" ; lv2:name "Clock pulse width (ms)" ; lv2:default 1 ; lv2:minimum 1 ; lv2:maximum 10 ; lv2:portProperty lv2:integer, lv2:enumeration, lv2:connectionOptional ;
   lv2:scalePoint [ rdfs:label "1 ms" ; rdf:value 1 ], [ rdfs:label "5 ms" ; rdf:value 5 ], [ rdfs:label "10 ms" ; rdf:value 10 ] ] .
